# LUPA web application configuration template
# Copy values manually into your local environment; do not commit secret files.

NODE_ENV=development
PORT=3000

# Optional public analytics. Leave empty to disable analytics locally.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Managed development proxy variables. Never expose private values using a
# VITE_ prefix because those values are sent to the browser.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
