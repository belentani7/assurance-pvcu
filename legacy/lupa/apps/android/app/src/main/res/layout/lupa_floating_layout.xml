<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end">

    <ImageView
        android:id="@+id/lupa_bubble_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/lupa_circle_background"
        android:src="@android:drawable/ic_menu_search"
        android:tint="#FFFFFF"
        android:padding="14dp"
        android:elevation="8dp"
        android:contentDescription="LUPA" />

    <LinearLayout
        android:id="@+id/lupa_expanded_panel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/lupa_panel_background"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/lupa_blue"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/lupa_explanation_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_choose_concept"
            android:textSize="14sp"
            android:textColor="@color/lupa_text"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/concept_variable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/concept_variable" />

        <Button
            android:id="@+id/concept_function"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/concept_function" />

        <Button
            android:id="@+id/concept_loop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/concept_loop" />

        <Button
            android:id="@+id/concept_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/concept_condition" />
    </LinearLayout>
</LinearLayout>
